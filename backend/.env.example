# ── Application ──────────────────────────────────────────
APP_NAME="Open Brain API"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openbrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openbrain

# ── JWT ──────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_123456789
RESEND_FROM=Open Brain <onboarding@resend.dev>

# ── Frontend URLs (used in email links) ──────────────────
FRONTEND_URL=http://localhost:5173
VERIFY_EMAIL_REDIRECT=http://localhost:5173/verify-email
RESET_PASSWORD_REDIRECT=http://localhost:5173/reset-password

# ── AI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG / Chunking ───────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_CHUNK_METHOD=recursive
RAG_SEMANTIC_THRESHOLD=90

# ── RAG / Hybrid Retrieval ───────────────────────────────
RAG_HYBRID_ENABLED=false
RAG_HYBRID_VECTOR_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3

# ── RAG / Reranker ───────────────────────────────────────
RAG_RERANK_ENABLED=false
RAG_RERANK_TOP_N=10
RAG_COARSE_TOP_K=100

# ── RAG / Agent ──────────────────────────────────────────
RAG_AGENT_ENABLED=false
RAG_AGENT_MAX_ITERATIONS=5

# ── Invitations ────────────────────────────────────────
INVITE_WITH_EMAIL=true

# ── S3 / Object Storage (MinIO) ──────────────────────────
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=openbrain-attachments
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL=

# ── S3 / Object Storage ──────────────────────────────────
# Leave S3_ENDPOINT_URL empty for AWS S3, set for MinIO / R2 / LocalStack
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=openbrain
# Set to true for MinIO / LocalStack (path-style URLs)
S3_USE_PATH_STYLE=false
# CDN/public base URL — leave empty to use presigned URLs
S3_PUBLIC_URL=
INVITE_WITH_EMAIL=<true or false>
