# ── Application ──────────────────────────────────────────
APP_NAME="Open Brain API"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openbrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openbrain

# ── JWT ──────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_123456789
RESEND_FROM=Open Brain <onboarding@resend.dev>

# ── Frontend URLs (used in email links) ──────────────────
FRONTEND_URL=http://localhost:5173
VERIFY_EMAIL_REDIRECT=http://localhost:5173/verify-email
RESET_PASSWORD_REDIRECT=http://localhost:5173/reset-password

# ── AI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG / Chunking ───────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ── RAG / Vector Store ───────────────────────────────────
# Provider: pg_vector | weaviate | pinecone
VECTOR_STORE_PROVIDER=pg_vector
PINECONE_API_KEY=
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ── S3 / Object Storage (MinIO) ──────────────────────────
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── S3 / Object Storage ──────────────────────────────────
# Leave S3_ENDPOINT_URL empty for AWS S3, set for MinIO / R2 / LocalStack
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=openbrain
# Set to true for MinIO / LocalStack (path-style URLs)
S3_USE_PATH_STYLE=false
# CDN/public base URL — leave empty to use presigned URLs
S3_PUBLIC_URL=
